{
  "appId": "my.pizzadonia.app",
  "appName": "Pizzadonia",
  "webDir": "www",
  "server": {
    "url": "https://pizzadonia.pages.dev",
    "androidScheme": "https",
    "errorPath": "index.html",
    "allowNavigation": [
      "pizzadonia.pages.dev",
      "*.pizzadonia.pages.dev"
    ]
  },
  "android": {
    "allowMixedContent": false
  },
  "plugins": {
    "SystemBars": {
      "style": "LIGHT",
      "insetsHandling": "css"
    }
  }
}
