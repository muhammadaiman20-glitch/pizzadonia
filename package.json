{
  "name": "pizzadonia",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "deploy": "npm run build && node scripts/prepare-download.mjs && wrangler deploy",
    "deploy:pages": "VITE_API_BASE=https://pizzadonia.muhammadaiman20.workers.dev/api npm run build && node scripts/prepare-download.mjs && wrangler pages deploy dist --project-name pizzadonia --branch main",
    "worker:dev": "wrangler dev",
    "typecheck:worker": "tsc -p worker/tsconfig.json",
    "db:init": "wrangler d1 execute kewanganku-sync --remote --file worker/schema.sql",
    "db:init:local": "wrangler d1 execute kewanganku-sync --local --file worker/schema.sql"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.6.2",
    "lucide-react": "^1.72.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@cloudflare/workers-types": "^5.20261114.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "wrangler": "^4.162.0"
  }
}
