# HTML sentiasa disemak semula supaya app tidak kekal pada UI lama
# (contoh butang demo yang sudah dibuang).
/
  Cache-Control: no-cache, must-revalidate
/index.html
  Cache-Control: no-cache, must-revalidate
/seller
  Cache-Control: no-cache, must-revalidate
/seller.html
  Cache-Control: no-cache, must-revalidate
/download
  Cache-Control: no-cache, must-revalidate
/download.html
  Cache-Control: no-cache, must-revalidate

# Aset berhash boleh dicache lama kerana nama fail berubah setiap build.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
